manifest {
    name = 'scDrugFlow'
    description = 'A small, reproducible workflow for exploratory single-cell perturbation analysis'
    version = '0.1.0'
}

profiles {
    conda {
        conda.enabled = true
    }
    // Use this profile with a separately activated environment (e.g. for a quick local test).
    local {
        conda.enabled = false
    }
}

process {
    executor = 'local'
    cpus = 2
    memory = '4 GB'
    errorStrategy = 'terminate'
}

// Nextflow creates run traces with -with-report/-with-trace/-with-timeline when requested.
